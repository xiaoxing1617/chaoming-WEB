{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/testList/testList",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path" : "pages/login/login",
			"style": {
				"navigationStyle": "custom"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "朝明在线刷课系统",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#BFBFBF",
		"selectedColor": "#2595E8",
		"backgroundColor": "#fff",
		"list":[
			{
				"pagePath":"pages/index/index",
				"text":"课程",
				"iconPath":"static/tabBar/index_0.png",
				"selectedIconPath":"static/tabBar/index_1.png"
			},
			{
				"pagePath":"pages/testList/testList",
				"text":"考试",
				"iconPath":"static/tabBar/test_0.png",
				"selectedIconPath":"static/tabBar/test_1.png"
			}
		]
	},
	"uniIdRouter": {},
	"easycom": {
	  "autoscan": true,
	  "custom": {
	    "^u-(.*)": "@/components/u-$1/u-$1.vue" // 匹配components目录内的vue文件
	  }
	}
}